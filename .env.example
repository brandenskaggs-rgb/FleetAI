# Fleet AI production/deploy template — Railway.app
# Copy to .env and fill with real secrets before deployment.

NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# ── PostgreSQL (Railway — provided automatically when you add a Postgres plugin) ──
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=postgresql://user:password@host.railway.internal:5432/railway?sslmode=require

# Legacy paths (now superseded by PostgreSQL — keep commented unless reverting)
# AUTH_STORE_PATH=
# FLEETAI_DB_PATH=

# Required: use a long random secret in production (32+ chars minimum).
FLEETAI_SESSION_SECRET=replace-with-a-long-random-secret

# Bootstrap only for initial provisioning; disable/remove after first admin is created.
FLEETAI_SETUP_KEY=replace-with-one-time-bootstrap-key
FLEETAI_ALLOW_SETUP=false

# Production hardening: all dev/demo helpers must stay off.
DEV_SETUP=false
DEV_SETUP_MODE=false
DEV_SETUP_RESET_PASSWORDS=false
# DEV_SETUP_PASSWORD=
# ADMIN_PASSWORD=
# EMPLOYEE_PASSWORD=
# CUSTOMER_PASSWORD=
# AUTH_DEMO_WHITELIST=

# Cloudflare Tunnel / reverse proxy deployment
# Default code behavior in production trusts local proxies only.
# Override only if you have a specific proxy topology.
TRUST_PROXY=loopback, linklocal, uniquelocal

# Comma-separated browser origins allowed to make credentialed requests.
# If you serve Fleet AI from one public hostname, set it here.
CORS_ALLOWED_ORIGINS=https://fleet.example.com

# Cookies are secure by default in production.
COOKIE_SAMESITE=Lax
COOKIE_SECURE=true

# Optional service toggles
AI_ENABLED=false
ALERTS_ENABLED=true
OPENAI_EXPLANATIONS_ENABLED=false
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Python ML service
# Run locally with: npm run ml:service
FLEETAI_PYTHON_ML_ENABLED=true
FLEETAI_ML_SERVICE_URL=http://127.0.0.1:8010
FLEETAI_ML_SERVICE_TIMEOUT_MS=2500

# Private personal ML API for trusted local projects.
# Disabled by default. Use a long random key and keep local-only unless you
# intentionally put this behind your own private network/VPN.
INTERNAL_ML_API_ENABLED=false
# INTERNAL_ML_API_KEY=replace-with-at-least-32-random-characters
INTERNAL_ML_API_LOCAL_ONLY=true

# Optional API/token auth for non-browser integrations
# FLEETAI_API_TOKEN=
