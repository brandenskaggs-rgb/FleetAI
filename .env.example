# Fleet AI production/deploy template — Railway.app
# Copy to .env and fill with real secrets before deployment.

NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# ── PostgreSQL (Railway — provided automatically when you add a Postgres plugin) ──
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=postgresql://user:password@host.railway.internal:5432/railway?sslmode=require

# Legacy paths (now superseded by PostgreSQL — keep commented unless reverting)
# AUTH_STORE_PATH=
# FLEETAI_DB_PATH=

# Required: use a long random secret in production (32+ chars minimum).
FLEETAI_SESSION_SECRET=replace-with-a-long-random-secret

# Bootstrap only for initial provisioning; disable/remove after first admin is created.
FLEETAI_SETUP_KEY=replace-with-one-time-bootstrap-key
FLEETAI_ALLOW_SETUP=false

# Production hardening: all dev/demo helpers must stay off.
DEV_SETUP=false
DEV_SETUP_MODE=false
DEV_SETUP_RESET_PASSWORDS=false
# DEV_SETUP_PASSWORD=
# ADMIN_PASSWORD=
# EMPLOYEE_PASSWORD=
# CUSTOMER_PASSWORD=
# AUTH_DEMO_WHITELIST=

# Cloudflare Tunnel / reverse proxy deployment
# Default code behavior in production trusts local proxies only.
# Override only if you have a specific proxy topology.
TRUST_PROXY=loopback, linklocal, uniquelocal

# Comma-separated browser origins allowed to make credentialed requests.
# If you serve Fleet AI from one public hostname, set it here.
CORS_ALLOWED_ORIGINS=https://fleet.example.com

# Cookies are secure by default in production.
COOKIE_SAMESITE=Lax
COOKIE_SECURE=true

# Optional service toggles
AI_ENABLED=false
ALERTS_ENABLED=true
OPENAI_EXPLANATIONS_ENABLED=false
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Python ML service
# Run locally with: npm run ml:service
FLEETAI_PYTHON_ML_ENABLED=true
FLEETAI_ML_SERVICE_URL=http://127.0.0.1:8010
FLEETAI_ML_SERVICE_TIMEOUT_MS=2500
# Set the same 32+ character secret on Node and the Python ML service.
# FLEETAI_ML_INTERNAL_TOKEN=replace-with-a-random-service-token

# Private personal ML API for trusted local projects.
# Disabled by default. Use a long random key and keep local-only unless you
# intentionally put this behind your own private network/VPN.
INTERNAL_ML_API_ENABLED=false
# INTERNAL_ML_API_KEY=replace-with-at-least-32-random-characters
INTERNAL_ML_API_LOCAL_ONLY=true

# Optional API/token auth for non-browser integrations
# FLEETAI_API_TOKEN=

# AI advisor and report generation through Groq
# Get a free key at https://console.groq.com
AI_PROVIDER=groq
GROQ_API_KEY=gsk_replace_with_real_key
GROQ_MODEL=openai/gpt-oss-120b

# FMCSA ELD release controls. Keep production disabled until the exact app,
# gateway, and software version is registered and publicly listed by FMCSA.
ELD_PRODUCTION_ENABLED=false
ELD_OFFLINE_ENGINE_COMPLETE=false
ELD_HOS_ENGINE_VALIDATED=false
ELD_ROADSIDE_DISPLAY_COMPLETE=false
ELD_TRANSFER_IMPLEMENTATION_COMPLETE=false
ELD_INDEPENDENT_REVIEW_COMPLETE=false
ELD_FIELD_VALIDATION_COMPLETE=false
ELD_FMCSA_LISTING_CONFIRMED=false
# FMCSA_ELD_AUTH_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."
# FMCSA_ELD_CLIENT_CERT="-----BEGIN CERTIFICATE-----\n..."
# FMCSA_ELD_CLIENT_KEY="-----BEGIN PRIVATE KEY-----\n..."
# FMCSA_ELD_WEBSERVICE_URL=
# FMCSA_ELD_EMAIL_ADDRESS=

# Controlled learning is opt-in per tenant. Never enable from Advisor messages.
FLEETAI_CONTROLLED_LEARNING_TARGETS={}
FLEETAI_COMPONENT_EVIDENCE=false
# FLEETAI_ML_ARTIFACT_DIR=/absolute/persistent-volume/ml
# FLEETAI_LEARNING_GATES_FILE=/absolute/operator-reviewed-gates.json
# Only advertise builds after uploading and testing them. Never publish signing credentials here.
# Google Play VERSION_CODE must already be available in the intended Play track.
# FLEETAI_DRIVER_PLAY_VERSION_CODE=18
# FLEETAI_DRIVER_PLAY_VERSION_NAME=1.10.6
# FLEETAI_DRIVER_PILOT_DEBUG_VERSION_CODE=18
# FLEETAI_DRIVER_PILOT_DEBUG_VERSION_NAME=1.10.6
# FLEETAI_DRIVER_PILOT_DEBUG_URL=https://fleetaiops.com/downloads/driver/fleetai-driver-18.apk
# FLEETAI_DRIVER_RELEASE_DIR=/absolute/persistent-volume/driver-releases
# FLEETAI_DRIVER_PILOT_DEBUG_NOTES=Update while parked. Keep Fleet AI installed.
