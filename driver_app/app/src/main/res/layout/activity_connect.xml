<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    tools:ignore="HardcodedText">

    <ImageView
        android:id="@+id/connectLogo"
        android:layout_width="180dp"
        android:layout_height="72dp"
        android:contentDescription="@string/logo_content_description"
        android:scaleType="fitStart"
        app:tint="?android:attr/textColorPrimary"
        android:src="@drawable/fleet_ai_link" />

    <TextView
        android:id="@+id/connectTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Fleet AI / Connection setup"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/connectHelp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Use the server address supplied by your fleet manager." />

    <EditText
        android:id="@+id/serverInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Server URL"
        android:inputType="textUri"
        android:importantForAutofill="no" />

    <TextView
        android:id="@+id/serverError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#B00020" />

    <Button
        android:id="@+id/btnTestServer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Test Connection" />

    <TextView
        android:id="@+id/testHostStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Host reachable: --" />

    <TextView
        android:id="@+id/testPortStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Port open: --" />

    <TextView
        android:id="@+id/testHttpStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HTTP /health: --" />

    <TextView
        android:id="@+id/testAdvice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="" />

    <Button
        android:id="@+id/btnSaveServer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Save" />
</LinearLayout>
</ScrollView>
