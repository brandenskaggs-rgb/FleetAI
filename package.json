{
  "name": "fleet-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Run the backend (FastAPI) and open the UI to view mock telemetry.",
  "main": "index.js",
  "engines": {
    "node": ">=20 <26"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "dev:reset": "node scripts/dev-reset.js",
    "dev:start": "node -e \"process.env.DEV_SETUP='true'; require('./server.js')\"",
    "prod:start": "node -e \"process.env.DEV_SETUP='false'; require('./server.js')\"",
    "smoke": "node scripts/smoke.js",
    "smoke:solutions": "node scripts/solution-smoke.js",
    "check:hosts": "node scripts/check-hardcoded-hosts.js",
    "check:dashboard": "node scripts/check-dashboard-pairing.js",
    "validate-config": "node scripts/validate-config.js",
    "check:ui": "node scripts/ui-smoke.js",
    "pairing:selftest": "node scripts/pairing-selftest.js",
    "preflight": "node tools/preflight-check.js",
    "audit:links": "node tools/link-audit.js",
    "verify": "npm run preflight && npm run audit:links",
    "launch:check": "node scripts/validate-config.js && node tools/preflight-check.js && node scripts/ui-smoke.js && node scripts/check-dashboard-pairing.js && node scripts/check-hardcoded-hosts.js && node tools/link-audit.js",
    "tag:known-good": "node tools/print-tag-instructions.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.9.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0"
  }
}
